# Remote execution settings, sourced by scripts/remote/*.sh locally and on the server.
REMOTE_HOST=gpu-server                          # SSH alias from ~/.ssh/config; key-based login required
REMOTE_DIR=project                              # project path on the server; relative paths start at the remote home
REMOTE_CONDA_ACTIVATE=~/miniconda3/bin/activate # conda's bin/activate on the server; leave empty to skip activation
REMOTE_ENV=myenv                                # conda environment to activate
# Top-level directories that exist only on the server; sync never sends or deletes them.
REMOTE_SERVER_DIRS="data artifacts tmp"
# Directory names kept only on the local machine, at any depth; sync never sends them.
REMOTE_LOCAL_EXCLUDES=".venv venv node_modules .ipynb_checkpoints .mypy_cache .pytest_cache"
# File patterns sync never sends or overwrites and delete.sh never removes, such as model weights.
REMOTE_PROTECTED_PATTERNS="*.pt *.pth *.ckpt *.safetensors *.bin"
# Sync deletes a stale code file only when an earlier sync pushed it and it is now gone locally.
# REMOTE_PRUNE_CODE=0 keeps all stale files and only reports them.
REMOTE_PRUNE_CODE=1
REMOTE_CODE_PATTERNS="*.py *.sh *.pyx *.c *.cpp *.cu *.h *.yaml *.yml *.toml *.cfg *.ini"
